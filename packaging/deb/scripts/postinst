#!/bin/sh
set -e

if ! id -u exfilguard >/dev/null 2>&1; then
    adduser --system --group --home /var/lib/exfilguard --no-create-home --shell /usr/sbin/nologin exfilguard >/dev/null 2>&1 || true
fi

# These owner/mode guarantees must stay aligned with the CA loader. Existing
# CA files are deliberately left untouched; the service creates them as the
# exfilguard user on first startup; provisioned files remain operator-managed
# material that startup validates with actionable errors.
install -d -o exfilguard -g exfilguard -m 0700 /var/lib/exfilguard
install -d -o exfilguard -g exfilguard -m 0700 /var/lib/exfilguard/ca
install -d -o exfilguard -g exfilguard -m 0700 /var/lib/exfilguard/cache
install -d -o root -g exfilguard -m 0750 /etc/exfilguard
install -d -o root -g exfilguard -m 0750 /etc/exfilguard/config.d
install -d -o root -g exfilguard -m 0750 /etc/exfilguard/clients.d
install -d -o root -g exfilguard -m 0750 /etc/exfilguard/policies.d

for file in /etc/exfilguard/*.toml; do
    [ -f "$file" ] || continue
    chown root:exfilguard "$file"
    chmod 0640 "$file"
done

if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null 2>&1 || true

    # Keep an active service running while dpkg replaces package files, then
    # restart it onto the new binary. An administratively stopped service stays
    # stopped, and policy-rc.d remains authoritative through deb-systemd-invoke.
    if [ "$1" = "configure" ] && [ -n "${2:-}" ]; then
        # Packages before 0.9 stopped the service from their old prerm, so its
        # previous active state is no longer observable here. Restore the normal
        # enabled deployment during that one transition. Fixed-to-fixed upgrades
        # use try-restart and therefore preserve an intentional stopped state.
        if dpkg --compare-versions "$2" lt 0.9.0 \
            && systemctl --system is-enabled --quiet exfilguard.service; then
            deb-systemd-invoke start exfilguard.service >/dev/null 2>&1 || true
        else
            deb-systemd-invoke try-restart exfilguard.service >/dev/null 2>&1 || true
        fi
    fi
fi

exit 0
