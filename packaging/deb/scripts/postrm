#!/bin/sh
set -e

if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null 2>&1 || true
    systemctl --system reset-failed exfilguard.service >/dev/null 2>&1 || true
fi

if [ "$1" = "purge" ]; then
    rm -rf -- "${DPKG_ROOT:-}/var/lib/exfilguard"
fi

exit 0
